---
import Base from '../layouts/Base.astro';
import TarjetaProducto from '../components/TarjetaProducto.astro';
import { catalogo, t } from '../lib/sitio.mjs';
---

<Base titulo={t('inicio.meta.titulo')} descripcion={t('inicio.meta.descripcion')} ruta="" actual="inicio">
  <div class="contenedor bloque">
    <ul class="grilla">
      {catalogo.productos.map((p) => <li><TarjetaProducto producto={p} /></li>)}
    </ul>
  </div>
</Base>
