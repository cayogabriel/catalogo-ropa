---
// Mi lista: se arma en el navegador desde localStorage con los datos compactos del catálogo.
import Base from '../../layouts/Base.astro';
import Icono from '../../components/Icono.astro';
import { catalogo, t, url, base, imagen } from '../../lib/sitio.mjs';
import { srcset, srcMenor } from '../../lib/imagenes.mjs';
import { rutaProducto } from '../../compartido/enlaces.mjs';

const productos = catalogo.productos.map((p) => {
  const img = imagen(p.fotos[0].id);
  return {
    id: p.id,
    codigo: p.codigo,
    nombre: p.nombre,
    vendedora_id: p.vendedora_id,
    precio: { ventanas: p.precio.ventanas },
    tallas: p.tallas,
    tallas_agotadas: p.tallas_agotadas,
    colores: p.colores,
    estado: p.estado,
    url: url(rutaProducto(p.codigo)),
    foto: { src: srcMenor(img, base), srcset: srcset(img, base), ancho: img.ancho, alto: img.alto, lqip: img.lqip, alt: p.fotos[0].alt },
  };
});
---

<Base titulo={`${t('lista.titulo')} · ${catalogo.tienda.nombre}`} descripcion={t('lista.nota')} ruta="lista/" actual="lista">
  <div class="contenedor lista-pagina" data-pagina-lista data-productos={JSON.stringify(productos)}>
    <h1 tabindex="-1">{t('lista.titulo')}</h1>

    <div class="lista-vacia" data-vacia>
      <p>{t('lista.vacia')}</p>
      <a class="boton boton-primario" href={url('catalogo/')}>{t('catalogo.titulo')}</a>
    </div>

    <ul class="lista-items" data-items hidden></ul>

    <div class="lista-resumen" data-resumen hidden>
      <p class="lista-total">
        <span>{t('lista.total')}</span>
        <strong data-total></strong>
      </p>
      <a class="boton boton-primario boton-ancho" href="#" target="_blank" rel="noopener" data-enviar data-evento="whatsapp">
        <Icono nombre="whatsapp" />
        {t('lista.enviar_whatsapp')}
        <span class="sr">({t('accesibilidad.abrir_whatsapp')})</span>
      </a>
      <button type="button" class="boton boton-secundario boton-ancho" data-vaciar>{t('lista.vaciar')}</button>
      <p class="texto-suave lista-nota">{t('lista.nota')}</p>
    </div>
  </div>

  <template data-plantilla>
    <li class="item">
      <a class="item-foto marco-foto" data-enlace tabindex="-1"><img class="foto" alt="" loading="lazy" decoding="async" /></a>
      <div class="item-info">
        <h2 class="item-nombre"><a data-enlace data-nombre></a></h2>
        <p class="item-precio" data-precio-item></p>
        <p class="item-agotado texto-suave" data-agotado hidden>{t('producto.agotado')}</p>
        <div class="item-opciones">
          <div class="campo" data-campo-talla>
            <label>{t('producto.elige_talla')}</label>
            <select data-talla></select>
          </div>
          <div class="campo" data-campo-color>
            <label>{t('producto.elige_color')}</label>
            <select data-color></select>
          </div>
        </div>
      </div>
      <button type="button" class="cerrar item-quitar" data-quitar>
        <Icono nombre="cerrar" />
        <span class="sr" data-quitar-texto>{t('producto.quitar_lista')}</span>
      </button>
    </li>
  </template>

  <script>
    import { iniciarListaPagina } from '../../cliente/lista-pagina.mjs';
    iniciarListaPagina();
  </script>
</Base>

<style>
  .lista-pagina {
    display: grid;
    gap: 1.5rem;
    padding-block: 1.5rem 2rem;
    max-width: 44rem;
  }
  .lista-pagina h1 {
    font-size: clamp(2rem, 8vw, 3rem);
  }
  .lista-vacia {
    display: grid;
    gap: 1rem;
    justify-items: start;
  }
  .lista-items {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }
  .lista-items :global(.item) {
    position: relative;
    display: grid;
    grid-template-columns: 6rem minmax(0, 1fr);
    gap: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--color-borde);
  }
  .lista-items :global(.item-info) {
    display: grid;
    gap: 0.375rem;
    align-content: start;
    padding-right: 2.75rem;
  }
  .lista-items :global(.item-nombre) {
    font-family: var(--t-texto);
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.3;
  }
  .lista-items :global(.item-nombre a) {
    text-decoration: none;
  }
  .lista-items :global(.item-opciones) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(7.5rem, 1fr));
    gap: 0.5rem;
    margin-top: 0.25rem;
  }
  .lista-items :global(.item-opciones label) {
    font-weight: 400;
    font-size: 0.875rem;
  }
  .lista-items :global(.item-quitar) {
    position: absolute;
    top: -0.5rem;
    right: -0.5rem;
  }
  .lista-resumen {
    display: grid;
    gap: 0.75rem;
  }
  .lista-total {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-size: 1.125rem;
  }
  .lista-nota {
    font-size: 0.875rem;
  }
</style>
