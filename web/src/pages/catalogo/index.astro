---
// Catálogo: todas las prendas en el HTML; el navegador filtra, busca y ordena según la URL.
import Base from '../../layouts/Base.astro';
import TarjetaProducto from '../../components/TarjetaProducto.astro';
import Icono from '../../components/Icono.astro';
import { catalogo, t, monto } from '../../lib/sitio.mjs';
import { opcionesFiltro } from '../../lib/filtros.mjs';
import { cantidadPrendas } from '../../lib/textos.mjs';

const categorias = [...catalogo.categorias].sort((a, b) => a.orden - b.orden);
const slugDe = new Map(catalogo.categorias.map((c) => [c.id, c.slug]));
const items = catalogo.productos.map((p, i) => ({
  codigo: p.codigo,
  nombre: p.nombre,
  categoria: slugDe.get(p.categoria_id) ?? '',
  tallas: p.tallas,
  agotadas: p.tallas_agotadas,
  colores: p.colores,
  orden: i,
}));
const opciones = opcionesFiltro(items.map((i) => ({ ...i, precio: 0 })));
const conProductos = categorias.filter((c) => items.some((i) => i.categoria === c.slug));
const precios = catalogo.productos.map((p) => p.precio.regular);
const ordenes = [
  ['recomendado', 'Recomendados'],
  ['precio-asc', 'Menor precio'],
  ['precio-desc', 'Mayor precio'],
  ['nombre', 'Nombre (A–Z)'],
];
---

<Base titulo={`${t('catalogo.titulo')} · ${catalogo.tienda.nombre}`} descripcion={t('tienda.descripcion_corta') || t('inicio.meta.descripcion')} ruta="catalogo/" actual="catalogo">
  <div class="contenedor catalogo">
    <div class="catalogo-cabecera">
      <h1>{t('catalogo.titulo')}</h1>
      <p class="texto-suave" data-resultados aria-live="polite">{cantidadPrendas(t, items.length)}</p>
    </div>

    <div class="catalogo-controles">
      <form class="buscador" role="search" data-buscador>
        <label class="sr" for="buscar">{t('catalogo.buscar')}</label>
        <Icono nombre="buscar" />
        <input id="buscar" name="q" type="search" placeholder={t('catalogo.buscar_placeholder')} autocomplete="off" enterkeyhint="search" maxlength="60" />
      </form>
      <button type="button" class="boton boton-secundario" data-abrir-filtros aria-haspopup="dialog" aria-controls="filtros">
        <Icono nombre="filtros" />
        {t('catalogo.filtros')}
        <span class="contador" data-cuenta-filtros hidden></span>
      </button>
      <div class="campo orden">
        <label for="orden">{t('catalogo.ordenar')}</label>
        <select id="orden" name="orden" data-orden>
          {ordenes.map(([valor, nombre]) => <option value={valor}>{nombre}</option>)}
        </select>
      </div>
    </div>

    <ul class="grilla" data-catalogo>
      {
        catalogo.productos.map((p, i) => (
          <li data-item={JSON.stringify(items[i])}>
            <TarjetaProducto producto={p} prioridad={i < 2} titulo="h2" />
          </li>
        ))
      }
    </ul>

    <div class="sin-resultados" data-sin-resultados hidden>
      <p>{t('catalogo.sin_resultados')}</p>
      <button type="button" class="boton boton-secundario" data-limpiar>{t('catalogo.limpiar_filtros')}</button>
    </div>
  </div>

  <dialog class="cajon" id="filtros" aria-labelledby="titulo-filtros" data-dialogo-filtros>
    <form class="filtros" data-filtros>
      <div class="hoja-barra">
        <h2 id="titulo-filtros">{t('catalogo.filtros')}</h2>
        <button type="button" class="cerrar" data-cerrar>
          <Icono nombre="cerrar" />
          <span class="sr">{t('accesibilidad.cerrar')}</span>
        </button>
      </div>
      <div class="filtros-cuerpo">
        <fieldset class="chips">
          <legend>Categoría</legend>
          <div class="chips-opciones">
            <label class="chip"><input type="radio" name="categoria" value="" checked /><span>Todas</span></label>
            {conProductos.map((c) => (
              <label class="chip"><input type="radio" name="categoria" value={c.slug} /><span>{c.nombre}</span></label>
            ))}
          </div>
        </fieldset>
        <fieldset class="chips">
          <legend>Talla</legend>
          <div class="chips-opciones">
            <label class="chip"><input type="radio" name="talla" value="" checked /><span>Todas</span></label>
            {opciones.tallas.map((talla) => (
              <label class="chip"><input type="radio" name="talla" value={talla} /><span>{talla}</span></label>
            ))}
          </div>
        </fieldset>
        <fieldset class="chips">
          <legend>Color</legend>
          <div class="chips-opciones">
            <label class="chip"><input type="radio" name="color" value="" checked /><span>Todos</span></label>
            {opciones.colores.map((color) => (
              <label class="chip"><input type="radio" name="color" value={color} /><span>{color}</span></label>
            ))}
          </div>
        </fieldset>
        <fieldset class="chips">
          <legend>Precio</legend>
          <div class="rango">
            <div class="campo">
              <label for="min">Desde ({catalogo.tienda.moneda.simbolo})</label>
              <input id="min" name="min" type="number" inputmode="numeric" min="0" step="1" placeholder={String(Math.floor(Math.min(...precios)))} />
            </div>
            <div class="campo">
              <label for="max">Hasta ({catalogo.tienda.moneda.simbolo})</label>
              <input id="max" name="max" type="number" inputmode="numeric" min="0" step="1" placeholder={String(Math.ceil(Math.max(...precios)))} />
            </div>
          </div>
        </fieldset>
        <label class="chip chip-ofertas">
          <input type="checkbox" name="oferta" value="1" />
          <span>{t('catalogo.solo_ofertas')}</span>
        </label>
      </div>
      <div class="filtros-pie">
        <button type="button" class="boton boton-secundario" data-limpiar>{t('catalogo.limpiar_filtros')}</button>
        <button type="submit" class="boton boton-primario" data-cerrar>{t('catalogo.aplicar_filtros')}</button>
      </div>
    </form>
  </dialog>

  <script>
    import { iniciarCatalogo } from '../../cliente/catalogo.mjs';
    iniciarCatalogo();
  </script>
</Base>

<style>
  .catalogo {
    padding-block: 1.5rem 2rem;
  }
  .catalogo-cabecera {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }
  .catalogo-cabecera h1 {
    font-size: clamp(2rem, 8vw, 3rem);
  }
  .catalogo-controles {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.5rem;
    align-items: end;
    margin-bottom: 1.5rem;
  }
  .buscador {
    grid-column: 1 / -1;
    position: relative;
  }
  .buscador :global(svg) {
    position: absolute;
    left: 0.875rem;
    top: 50%;
    width: 1.25rem;
    height: 1.25rem;
    margin-top: -0.625rem;
    color: var(--color-texto-suave);
    pointer-events: none;
  }
  .buscador input {
    width: 100%;
    min-height: 48px;
    padding: 0.625rem 0.75rem 0.625rem 2.75rem;
    border: 1px solid var(--color-control);
    border-radius: var(--radio);
    background: var(--color-superficie);
    font-size: 1rem;
  }
  .orden {
    grid-row: 2;
    grid-column: 1;
  }
  .orden label {
    font-size: 0.875rem;
  }
  @media (min-width: 48rem) {
    .catalogo-controles {
      grid-template-columns: 1fr auto 14rem;
    }
    .buscador {
      grid-column: 1;
    }
    .orden {
      grid-row: 1;
      grid-column: 3;
    }
  }
  .sin-resultados {
    display: grid;
    gap: 1rem;
    justify-items: start;
    padding-block: 2rem;
  }
  .filtros {
    display: grid;
    grid-template-rows: auto 1fr auto;
    height: 100%;
  }
  .filtros-cuerpo {
    overflow: auto;
    overscroll-behavior: contain;
    display: grid;
    gap: 1.75rem;
    align-content: start;
    padding: 1.25rem var(--margen);
  }
  .rango {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }
  .rango label {
    font-weight: 400;
    font-size: 0.875rem;
  }
  .chip-ofertas {
    justify-self: start;
  }
  .filtros-pie {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem;
    padding: 0.75rem var(--margen) max(0.75rem, env(safe-area-inset-bottom));
    border-top: 1px solid var(--color-borde);
    background: var(--color-superficie);
  }
</style>
