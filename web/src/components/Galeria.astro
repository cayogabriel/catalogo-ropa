---
// Galería deslizable (scroll-snap) con puntos y zoom a pantalla completa.
import Imagen from './Imagen.astro';
import Icono from './Icono.astro';
import { base, imagen, t } from '../lib/sitio.mjs';
import { srcMayor } from '../lib/imagenes.mjs';

interface Props {
  producto: any;
}
const { producto: p } = Astro.props;
const fotos = p.fotos;
const varias = fotos.length > 1;
---

<div class="galeria" data-galeria>
  <ul class="galeria-pista" data-pista aria-label={t('accesibilidad.foto_de', { producto: p.nombre })}>
    {
      fotos.map((f: any, i: number) => (
        <li class="galeria-diapo" aria-label={varias ? `${i + 1} de ${fotos.length}` : undefined}>
          <button type="button" class="galeria-zoom" data-zoom={i} data-grande={srcMayor(imagen(f.id), base)} data-alt={f.alt}>
            <Imagen foto={f} sizes="(min-width: 64rem) 36rem, (min-width: 48rem) 50vw, 100vw" prioridad={i === 0} transicion={i === 0 ? `foto-${p.codigo.toLowerCase()}` : undefined} />
            <span class="galeria-lupa">
              <Icono nombre="lupa-mas" />
              <span class="sr">Ampliar foto {i + 1}</span>
            </span>
          </button>
        </li>
      ))
    }
  </ul>
  {
    varias && (
      <div class="galeria-puntos">
        {fotos.map((_: any, i: number) => (
          <button type="button" class="galeria-punto" data-ir={i} aria-label={`Ver foto ${i + 1} de ${fotos.length}`} aria-current={i === 0 ? 'true' : undefined}>
            <span />
          </button>
        ))}
      </div>
    )
  }
</div>

<dialog class="zoom" aria-label={`Fotos de ${p.nombre}`} data-dialogo-zoom>
  <button type="button" class="cerrar zoom-cerrar" data-cerrar>
    <Icono nombre="cerrar" />
    <span class="sr">{t('accesibilidad.cerrar')}</span>
  </button>
  <div class="zoom-lienzo" data-lienzo>
    <img data-zoom-img alt="" />
  </div>
  {
    varias && (
      <div class="zoom-nav">
        <button type="button" class="boton boton-secundario" data-zoom-paso="-1">Anterior</button>
        <button type="button" class="boton boton-secundario" data-zoom-paso="1">Siguiente</button>
      </div>
    )
  }
</dialog>

<script>
  import { iniciarGaleria } from '../cliente/galeria.mjs';
  iniciarGaleria();
</script>

<style>
  .galeria {
    display: grid;
    gap: 0.5rem;
  }
  .galeria-pista {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 100%;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
    border-radius: var(--radio-chico);
  }
  .galeria-pista::-webkit-scrollbar {
    display: none;
  }
  .galeria-diapo {
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }
  .galeria-zoom {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: var(--color-borde);
    cursor: zoom-in;
  }
  .galeria-zoom :global(.foto) {
    width: 100%;
    aspect-ratio: 4 / 5;
  }
  .galeria-zoom:focus-visible {
    outline-offset: -4px;
  }
  .galeria-lupa {
    position: absolute;
    right: 0.75rem;
    bottom: 0.75rem;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 999px;
    background: var(--color-superficie);
    color: var(--color-texto);
  }
  .galeria-lupa :global(svg) {
    width: 1.25rem;
    height: 1.25rem;
  }
  .galeria-puntos {
    display: flex;
    justify-content: center;
  }
  .galeria-punto {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
  }
  .galeria-punto span {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
    border: 1px solid var(--color-control);
    transition: transform 200ms var(--ease-out), background-color 200ms ease;
  }
  .galeria-punto[aria-current='true'] span {
    background: var(--color-texto);
    border-color: var(--color-texto);
    transform: scale(1.25);
  }

  dialog.zoom {
    margin: 0;
    padding: 0;
    width: 100vw;
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    border: 0;
    background: var(--color-fondo);
    color: var(--color-texto);
    opacity: 0;
    transition: opacity 200ms ease;
  }
  dialog.zoom:global(.abierta) {
    opacity: 1;
  }
  .zoom-cerrar {
    position: absolute;
    top: max(0.5rem, env(safe-area-inset-top));
    right: 0.5rem;
    z-index: 2;
    background: var(--color-superficie);
  }
  .zoom-lienzo {
    width: 100%;
    height: 100%;
    overflow: auto;
    display: grid;
    place-items: center;
    cursor: zoom-in;
    touch-action: pan-x pan-y pinch-zoom;
  }
  .zoom-lienzo img {
    max-width: 100%;
    max-height: 100dvh;
    object-fit: contain;
  }
  .zoom-lienzo:global(.ampliada) {
    place-items: start;
    cursor: zoom-out;
  }
  .zoom-lienzo:global(.ampliada) img {
    max-width: none;
    max-height: none;
    width: 200%;
  }
  .zoom-nav {
    position: absolute;
    left: 50%;
    bottom: max(1rem, env(safe-area-inset-bottom));
    translate: -50% 0;
    display: flex;
    gap: 0.5rem;
  }
  .zoom-nav .boton {
    background: var(--color-superficie);
  }
</style>
