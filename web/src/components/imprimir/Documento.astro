---
// Marco de los documentos para imprimir (revista y catálogo PDF): páginas de
// 1080 × 1350 px con la paleta y las fuentes de la temporada.
// La página se ve en un celular a ~390 px de ancho (×0,36): por eso los
// botones miden 120 px (≈ 44 px en pantalla) y ningún texto baja de 28 px.
interface Props {
  titulo: string;
  ahora: number;
  paleta: { tokens: Record<string, string>; fuentes: { titulos: string; texto: string }; radio: string };
}

const { titulo, paleta, ahora } = Astro.props;
// Solo nombres de familia simples: cualquier otro carácter podría romper el CSS.
const fuenteSegura = (f: string) => (/^[A-Za-z0-9 ]{1,60}$/.test(f) ? f : null);
const titulos = fuenteSegura(paleta.fuentes.titulos);
const textoF = fuenteSegura(paleta.fuentes.texto);
const familias = [...new Set([titulos, textoF].filter(Boolean))];
// 400 y 700: Google omite los pesos que una familia no tiene (y la familia
// entera si no tiene ninguno), y las de un solo peso (Abril Fatface, Bree
// Serif…) solo traen 400.
const fuentes = familias.length
  ? `https://fonts.googleapis.com/css2?${familias.map((f) => `family=${f.replace(/ /g, '+')}:wght@400;700`).join('&')}&display=swap`
  : null;
const colorSeguro = (v: string) => /^#[0-9A-Fa-f]{6}$/.test(v);
const radio = /^\d{1,3}px$/.test(paleta.radio) ? paleta.radio : '16px';
const variables = [
  ...Object.entries(paleta.tokens)
    .filter(([k, v]) => /^--color-[a-z-]+$/.test(k) && colorSeguro(v))
    .map(([k, v]) => `${k}:${v}`),
  `--fuente-titulos:${titulos ? `'${titulos}',` : ''}system-ui,sans-serif`,
  `--fuente-texto:${textoF ? `'${textoF}',` : ''}system-ui,sans-serif`,
  `--radio:${radio}`,
].join(';');
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=1080" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="construido" content={String(ahora)} />
    <title>{titulo}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {fuentes && <link rel="stylesheet" href={fuentes} />}
    <style set:html={`:root{${variables}}`} />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  @page {
    size: 1080px 1350px;
    margin: 0;
  }
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }
  html {
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }
  body {
    background: #6f6f6f;
    color: var(--color-texto);
    font-family: var(--fuente-texto);
    font-size: 32px;
    line-height: 1.4;
    margin: 0;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }
  @media print {
    body {
      background: none;
    }
  }
  h1,
  h2,
  h3,
  p {
    margin: 0;
  }
  h1,
  h2,
  h3 {
    font-family: var(--fuente-titulos);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.02;
    text-wrap: balance;
  }
  p {
    text-wrap: pretty;
  }
  a {
    color: inherit;
  }
  img {
    display: block;
    height: auto;
    max-width: none;
    object-fit: cover;
  }
  /* Contorno apenas visible: separa del fondo las fotos de fondo claro. */
  .prenda__foto,
  .doble__foto,
  .sola__foto,
  .fila__foto {
    outline: 1px solid rgb(0 0 0 / 0.08);
    outline-offset: -1px;
  }

  /* Una página = 1080 × 1350. En pantalla se apilan con aire entre ellas. */
  .pagina {
    background: var(--color-fondo);
    break-after: page;
    height: 1350px;
    margin: 0 auto 48px;
    overflow: hidden;
    position: relative;
    width: 1080px;
  }
  .pagina:last-child {
    break-after: auto;
  }
  @media print {
    .pagina {
      margin: 0;
    }
  }

  /* Pie de cada página: vigencia a la izquierda, tienda y número a la derecha. */
  .pie {
    align-items: center;
    bottom: 0;
    color: var(--color-texto-suave);
    display: flex;
    font-size: 28px;
    gap: 24px;
    height: 96px;
    justify-content: space-between;
    left: 72px;
    position: absolute;
    right: 72px;
  }
  .pie__pagina {
    display: flex;
    gap: 24px;
  }
  .pie__vigencia {
    color: var(--color-texto);
    font-weight: 700;
  }
  .pie--sobre-foto,
  .pie--sobre-foto .pie__vigencia {
    color: #fff;
  }

  /* Botón: área de toque de 120 px de alto. */
  .boton {
    align-items: center;
    background: var(--color-primario);
    border-radius: 999px;
    color: var(--color-sobre-primario);
    display: inline-flex;
    font-family: var(--fuente-titulos);
    font-size: 34px;
    font-weight: 700;
    gap: 18px;
    justify-content: center;
    min-height: 120px;
    padding: 0 48px;
    text-decoration: none;
    white-space: nowrap;
  }
  .boton svg {
    flex: none;
    height: 40px;
    width: 40px;
  }
  .boton--claro {
    background: #fff;
    color: #000;
  }
  .boton--borde {
    background: transparent;
    border: 3px solid var(--color-control);
    color: var(--color-texto);
  }

  /* Precio: «ahora» grande; «antes» tachado y más chico, solo con oferta real. */
  .precio {
    align-items: baseline;
    font-variant-numeric: tabular-nums;
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
  }
  .precio__ahora {
    font-family: var(--fuente-titulos);
    font-size: 56px;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1;
  }
  .precio--oferta .precio__ahora {
    color: var(--color-oferta);
  }
  .precio__antes {
    color: var(--color-texto-suave);
    font-size: 32px;
    text-decoration: line-through;
    text-decoration-thickness: 2px;
  }
  .insignias {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .insignia {
    background: var(--color-acento);
    border-radius: 999px;
    color: var(--color-sobre-acento);
    font-size: 26px;
    font-weight: 700;
    line-height: 1;
    padding: 12px 20px;
  }
  .insignia--oferta {
    background: var(--color-oferta);
    color: var(--color-sobre-oferta);
  }

  /* Contactos, redes y QR (contraportada de la revista y portada del catálogo). */
  .contra__contactos {
    line-height: 1.3;
    list-style: none;
    margin: 0 0 20px;
    padding: 0;
  }
  .contra__contactos {
    font-size: 36px;
  }
  .contra__contactos li {
    font-variant-numeric: tabular-nums;
  }
  .contra__telefono {
    white-space: nowrap;
  }
  .contra__nombre {
    font-weight: 700;
  }
  .contra__nota {
    color: var(--color-texto-suave);
    font-size: 30px;
  }
  .contra__redes {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    margin-top: 32px;
  }
  .contra__qr {
    flex: none;
    height: 260px;
    width: 260px;
  }
  .contra__qr svg {
    display: block;
    height: 100%;
    width: 100%;
  }

  /* Velo arriba de la portada, para el logo y la etiqueta. */
  .velo {
    inset: 0;
    position: absolute;
  }
  .velo--marca {
    background: linear-gradient(to bottom, rgb(0 0 0 / 0.5) 0%, rgb(0 0 0 / 0) 22%);
  }
</style>
