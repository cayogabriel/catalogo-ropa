---
// Créditos de una foto editorial: cada prenda con su precio, y su enlace ir/.
interface Props {
  creditos: Array<{ enlace: string; producto: { nombre: string }; precio: { ahora: string } }>;
  sobreFoto?: boolean;
}
const { creditos, sobreFoto = false } = Astro.props;
---

{
  creditos.length > 0 && (
    <ul class:list={['creditos', { 'creditos--sobre-foto': sobreFoto }]}>
      {creditos.map((c) => (
        <li>
          <a class="credito" href={c.enlace}>
            {c.producto.nombre} <strong>{c.precio.ahora}</strong>
          </a>
        </li>
      ))}
    </ul>
  )
}
