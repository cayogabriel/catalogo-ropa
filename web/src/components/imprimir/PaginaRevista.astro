---
// Una página de la revista, según su tipo en el plan (plan.mjs).
import datos from '../../data/catalogo.json';
import Foto from './Foto.astro';
import Pie from './Pie.astro';
import Precio from './Precio.astro';
import Boton from './Boton.astro';
import Creditos from './Creditos.astro';
import { texto } from './plan.mjs';
import { rutaImpresion } from './rutas.mjs';
import { qrSvg } from './qr.mjs';

interface Props {
  pagina: any;
  nota: string;
  pedir: string;
  paleta: { tokens: Record<string, string> };
}

const { pagina: p, nota, pedir, paleta } = Astro.props;
const tienda = datos.tienda.nombre;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const antes = texto(datos, 'precio.antes');
const codigo = (c: string) => texto(datos, 'producto.codigo', { codigo: c });
const tallas = (t: string[]) => (t.length === 1 ? `Talla ${/^única$/i.test(t[0]) ? 'única' : t[0]}` : `Tallas ${t.join(', ')}`);
const logo = datos.tienda.logo;
const qr = p.tipo === 'contraportada' ? await qrSvg(p.url, paleta.tokens['--color-texto']) : '';
const pie = { nota, tienda, numero: p.numero, total: p.total };
// El título de portada es lo más grande de la revista; si es largo, baja de
// tamaño para no pasar de 4 líneas. Lo mismo con los textos editoriales.
const largo = (t = '', corto: number, medio: number) => (t.length <= corto ? '' : t.length <= medio ? 'medio' : 'largo');
const tamTitulo = largo(p.titulo, 20, 36);
const tamTexto = largo(p.fotos?.[0]?.texto, 30, 60);
---

{
  p.tipo === 'portada' && (
    <section class="pagina portada">
      <Foto foto={p.foto} class="portada__foto" posicion="center top" />
      <div class="velo velo--arriba" />
      <header class="portada__marca">
        {logo ? <img class="portada__logo" src={base + rutaImpresion(logo.id, 540)} alt={tienda} /> : <span class="portada__tienda">{tienda}</span>}
        <span>{p.etiqueta}</span>
      </header>
      <div class="portada__texto">
        <p class="portada__temporada">{p.nombre}</p>
        <h1 class:list={['portada__titulo', tamTitulo && `portada__titulo--${tamTitulo}`]}>{p.titulo}</h1>
        <p class="portada__subtitulo">{p.subtitulo}</p>
        {p.intro && <p class="portada__intro">{p.intro}</p>}
      </div>
      <Pie {...pie} sobreFoto />
    </section>
  )
}

{
  p.tipo === 'editorial-completa' && (
    <section class="pagina completa">
      <Foto foto={p.fotos[0].foto} class="completa__foto" />
      <div class="velo" />
      <div class="completa__texto">
        {p.intro && <p class="intro intro--sobre-foto">{p.intro}</p>}
        <h2 class:list={['completa__titulo', tamTexto && `titulo--${tamTexto}`]}>{p.fotos[0].texto}</h2>
        <Creditos creditos={p.fotos[0].creditos} sobreFoto />
      </div>
      <Pie {...pie} sobreFoto />
    </section>
  )
}

{
  p.tipo === 'editorial-doble' && (
    <section class:list={['pagina doble', { 'doble--intro': p.intro }]}>
      {p.intro && <p class="intro doble__intro">{p.intro}</p>}
      {p.fotos.map((f: any, i: number) => (
        <figure class={`doble__figura doble__figura--${i + 1}`}>
          <Foto foto={f.foto} class="doble__foto" />
          <figcaption>
            <h2 class="doble__texto">{f.texto}</h2>
            <Creditos creditos={f.creditos} />
          </figcaption>
        </figure>
      ))}
      <Pie {...pie} />
    </section>
  )
}

{
  p.tipo === 'editorial-sola' && (
    <section class="pagina sola">
      <Foto foto={p.fotos[0].foto} class="sola__foto" />
      <div class="sola__texto">
        {p.intro && <p class="intro">{p.intro}</p>}
        <h2 class:list={['sola__titulo', tamTexto && `titulo--${tamTexto}`]}>{p.fotos[0].texto}</h2>
        <Creditos creditos={p.fotos[0].creditos} />
      </div>
      <Pie {...pie} />
    </section>
  )
}

{
  p.tipo === 'prendas' && (
    <section class:list={['pagina prendas', { 'prendas--una': p.prendas.length === 1 }]}>
      {p.prendas.map((x: any) => (
        <article class="prenda">
          <Foto foto={x.foto} class="prenda__foto" posicion="center top" />
          {x.insignias.length > 0 && (
            <p class="insignias prenda__insignias">
              {x.insignias.map((i: string, n: number) => (
                <span class:list={['insignia', { 'insignia--oferta': n === 0 && x.precio.antes }]}>{i}</span>
              ))}
            </p>
          )}
          <h2 class="prenda__nombre">{x.producto.nombre}</h2>
          <p class="prenda__detalle">
            {codigo(x.producto.codigo)}
            {x.tallas.length > 0 && <>. {tallas(x.tallas)}</>}
          </p>
          <Precio precio={x.precio} antesTexto={antes} />
          <Boton href={x.enlace} icono="chat" class="prenda__boton">
            {pedir}
          </Boton>
        </article>
      ))}
      <Pie {...pie} />
    </section>
  )
}

{
  p.tipo === 'contraportada' && (
    <section class="pagina contra">
      <p class="contra__cierre">{p.cierre}</p>
      <div class="contra__datos">
        <h2 class="contra__titulo">{p.titulo}</h2>
        <ul class="contra__contactos">
          {p.contactos.map((c: any) => (
            <li>
              <span class="contra__nombre">{c.nombre}</span> {c.telefono}
            </li>
          ))}
        </ul>
        {p.horario && <p class="contra__nota">{p.horario}</p>}
        {p.envios && <p class="contra__nota">{p.envios}</p>}
        {p.redes.length > 0 && (
          <p class="contra__redes">
            {p.redes.map((r: any) => (
              <Boton href={r.enlace} variante="borde">
                {r.nombre}
              </Boton>
            ))}
          </p>
        )}
      </div>
      <div class="contra__web">
        <div class="contra__qr" set:html={qr} role="img" aria-label={`Código QR de ${p.url}`} />
        <div class="contra__enlace">
          <p>{p.escaneaQr}</p>
          <p class="contra__url">{p.url.replace(/^https:\/\//, '')}</p>
          <Boton href={p.enlaceTemporada}>{texto(datos, 'temporada.ver_revista')}</Boton>
        </div>
      </div>
      <Pie {...pie} />
    </section>
  )
}

<style is:global>
  /* Portada: foto a sangre; el título es lo único grande de verdad. */
  .portada__foto,
  .completa__foto {
    height: 100%;
    inset: 0;
    position: absolute;
    width: 100%;
  }
  .portada__marca {
    align-items: center;
    color: #fff;
    display: flex;
    font-size: 30px;
    justify-content: space-between;
    left: 72px;
    position: absolute;
    right: 72px;
    top: 64px;
  }
  .portada__tienda {
    font-family: var(--fuente-titulos);
    font-size: 38px;
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .portada__logo {
    height: 88px;
    object-fit: contain;
    width: auto;
  }
  .portada__texto {
    bottom: 132px;
    color: #fff;
    left: 72px;
    position: absolute;
    right: 72px;
  }
  .portada__temporada {
    font-size: 34px;
    font-weight: 700;
    margin-bottom: 20px;
  }
  .portada__titulo {
    font-size: 168px;
    letter-spacing: -0.045em;
    line-height: 0.9;
    max-width: 920px;
  }
  .portada__titulo--medio {
    font-size: 128px;
  }
  .portada__titulo--largo {
    font-size: 92px;
    line-height: 0.95;
  }
  .completa__titulo.titulo--medio,
  .sola__titulo.titulo--medio {
    font-size: 72px;
  }
  .completa__titulo.titulo--largo,
  .sola__titulo.titulo--largo {
    font-size: 56px;
    line-height: 1.05;
  }
  .portada__subtitulo {
    font-size: 42px;
    line-height: 1.25;
    margin-top: 36px;
    max-width: 760px;
  }
  .portada__intro {
    font-size: 32px;
    margin-top: 20px;
    max-width: 760px;
    opacity: 0.92;
  }

  .intro {
    font-family: var(--fuente-titulos);
    font-size: 40px;
    font-weight: 500;
    line-height: 1.25;
    max-width: 820px;
  }
  .intro--sobre-foto {
    margin-bottom: 48px;
  }

  /* Créditos: las prendas de la foto, cada una con su enlace. */
  .creditos {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    list-style: none;
    margin: 28px 0 0;
    padding: 0;
  }
  .creditos li {
    max-width: 100%;
  }
  .credito {
    align-items: center;
    border: 3px solid currentColor;
    border-radius: 999px;
    display: inline-flex;
    font-size: 28px;
    gap: 6px 14px;
    line-height: 1.2;
    min-height: 88px;
    padding: 12px 32px;
    text-decoration: none;
  }
  .credito strong {
    font-weight: 700;
    white-space: nowrap;
  }

  /* Editorial a página completa. */
  .completa__texto {
    bottom: 132px;
    color: #fff;
    left: 72px;
    position: absolute;
    right: 72px;
  }
  .completa__titulo {
    font-size: 96px;
    letter-spacing: -0.035em;
    line-height: 0.95;
    max-width: 880px;
  }

  /* Dos fotos: una grande arriba a la izquierda, otra más chica abajo a la
     derecha, cada una con su texto al costado. */
  .doble__figura {
    margin: 0;
    position: absolute;
  }
  .doble__foto {
    aspect-ratio: 4 / 5;
    border-radius: var(--radio);
    width: 100%;
  }
  .doble__figura--1 {
    left: 72px;
    top: 72px;
    width: 500px;
  }
  .doble__figura--1 figcaption {
    left: calc(100% + 40px);
    position: absolute;
    top: 0;
    width: 396px;
  }
  .doble__figura--2 {
    bottom: 120px;
    right: 72px;
    width: 400px;
  }
  .doble__figura--2 figcaption {
    bottom: 0;
    position: absolute;
    right: calc(100% + 40px);
    text-align: right;
    width: 496px;
  }
  .doble__figura .creditos {
    flex-direction: column;
    align-items: flex-start;
  }
  .doble__figura--2 .creditos {
    align-items: flex-end;
  }
  .doble__texto {
    font-size: 52px;
    letter-spacing: -0.03em;
  }
  .doble--intro .doble__intro {
    left: 72px;
    position: absolute;
    right: 72px;
    top: 72px;
  }
  .doble--intro .doble__figura--1 {
    top: 300px;
    width: 470px;
  }
  .doble--intro .doble__figura--1 figcaption {
    width: 426px;
  }
  .doble--intro .doble__figura--2 {
    width: 360px;
  }
  .doble--intro .doble__figura--2 figcaption {
    width: 536px;
  }

  /* Una foto sola con su texto. */
  .sola__foto {
    aspect-ratio: 4 / 5;
    border-radius: var(--radio);
    left: 72px;
    position: absolute;
    top: 72px;
    width: 720px;
  }
  .sola__texto {
    bottom: 132px;
    left: 72px;
    position: absolute;
    right: 72px;
  }
  .sola__titulo {
    font-size: 88px;
    letter-spacing: -0.035em;
    line-height: 0.95;
    margin-top: 24px;
  }

  /* Prendas: dos columnas; foto 4:5, datos y botón alineados abajo. */
  .prendas {
    display: grid;
    gap: 48px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    padding: 72px 72px 120px;
  }
  .prendas--una {
    grid-template-columns: 1fr;
    padding-inline: 216px;
  }
  .prenda {
    display: flex;
    flex-direction: column;
  }
  /* Fotos del mismo alto en las dos columnas; el texto (hasta dos líneas de
     nombre) cabe en lo que queda y el botón cierra abajo. */
  .prenda__foto {
    border-radius: var(--radio);
    flex: none;
    height: 640px;
    margin-bottom: 28px;
    width: 100%;
  }
  .prenda__insignias {
    margin-bottom: 16px;
  }
  .prenda__nombre {
    font-size: 46px;
    letter-spacing: -0.02em;
    line-height: 1.05;
  }
  .prenda__detalle {
    color: var(--color-texto-suave);
    font-size: 28px;
    margin: 12px 0 20px;
  }
  .prenda__boton {
    font-size: 32px;
    margin-top: auto;
    padding: 0 28px;
    width: 100%;
  }
  .prenda .precio {
    margin-bottom: 28px;
  }

  /* Contraportada. */
  .contra {
    display: flex;
    flex-direction: column;
    padding: 96px 72px 120px;
  }
  .contra__cierre {
    font-family: var(--fuente-titulos);
    font-size: 72px;
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.02;
    text-wrap: balance;
  }
  .contra__datos {
    border-top: 3px solid var(--color-borde);
    margin-top: 64px;
    padding-top: 48px;
  }
  .contra__titulo {
    font-size: 44px;
    margin-bottom: 24px;
  }
  .contra__web {
    align-items: center;
    background: var(--color-superficie);
    border-radius: var(--radio);
    display: flex;
    gap: 48px;
    margin-top: auto;
    padding: 40px;
  }
  .contra__enlace p {
    font-size: 30px;
  }
  .contra__url {
    font-weight: 700;
    margin: 6px 0 24px;
    overflow-wrap: anywhere;
  }
</style>
